{
  "expo": {
    "name": "Tubelight",
    "slug": "tubelight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tubelight",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "studio.stepwise.tubelight",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "studio.stepwise.tubelight",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "image/*"
            },
            {
              "scheme": "content",
              "mimeType": "video/*"
            },
            {
              "scheme": "content",
              "mimeType": "audio/*"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "content",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "content",
              "mimeType": "text/csv"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            },
            {
              "scheme": "content",
              "mimeType": "application/json"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "image/*"
            },
            {
              "scheme": "file",
              "mimeType": "video/*"
            },
            {
              "scheme": "file",
              "mimeType": "audio/*"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "file",
              "mimeType": "text/csv"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            },
            {
              "scheme": "file",
              "mimeType": "application/json"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InterDisplay-Regular.ttf",
            "./assets/fonts/InterDisplay-Medium.ttf",
            "./assets/fonts/InterDisplay-SemiBold.ttf",
            "./assets/fonts/InterDisplay-Bold.ttf",
            "./assets/fonts/InstrumentSerif-Regular.ttf",
            "./assets/fonts/InstrumentSerif-Italic.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9FE3F0",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/pop.wav",
            "./assets/sounds/drop.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/pulse.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tubelight uses the microphone for voice conversations with your teammates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to share with your teammates.",
          "cameraPermission": "Take photos to share with your teammates."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tubelight uses the camera to scan the code that links your computer.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Tubelight to save images to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "./plugins/with-assistant",
      "expo-video",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f5fd60e-da22-4501-8c04-b1002fa479ee"
      }
    },
    "owner": "jayanth4109"
  }
}
