SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# LangGraph checkpointer + store (schema `langgraph`). Dashboard -> Connect -> Session pooler URI.
# Leave empty to run with in-memory memory (lost on restart).
SUPABASE_DB_URL=
# Model providers (free tiers). At least one key. Model ids are <provider>:<model>.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEFAULT_MODEL=openrouter:nvidia/nemotron-3-super-120b-a12b:free
ROUTER_MODEL=openrouter:nvidia/nemotron-3-super-120b-a12b:free
# Ordered fallbacks on 429/5xx/timeouts; entries whose provider has no key are skipped.
# Default: DEFAULT_MODEL, groq:openai/gpt-oss-120b, gemini:gemini-2.5-flash, mistral:mistral-small-latest
LLM_FALLBACKS=
# Optional: connectors (Gmail, GitHub, Linear, Notion). Composio Platform project key.
COMPOSIO_API_KEY=
APP_URL=http://localhost:8081
# http://localhost:8081 (Expo web) is always allowed
CORS_ORIGINS=http://localhost:8081
# Optional: token used only by the approved git_push sandbox tool
GITHUB_TOKEN=
# Optional overrides
# SANDBOX_IMAGE=tubelight-sandbox
# WORKSPACES_DIR=~/.tubelight/workspaces

# Cloudflare: Workers AI as a provider, and/or AI Gateway in front of every provider.
CF_ACCOUNT_ID=
CF_API_TOKEN=          # API token with "Workers AI: Read" (+ "AI Gateway: Read" for logs)
CF_GATEWAY_ID=         # gateway name from the AI Gateway dashboard; leave empty to call providers directly
CF_AIG_TOKEN=          # only if the gateway has Authenticated Gateway turned on
TTS_VOICES=            # optional: comma list of Orpheus voices, first is the default
